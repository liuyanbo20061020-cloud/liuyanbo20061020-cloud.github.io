<% var posts = page.posts && page.posts.toArray ? page.posts.toArray() : []; %>
<section class="listing-hero shell narrow">
  <div class="eyebrow">ARCHIVE</div>
  <h1>时间留下的痕迹</h1>
  <p>文章不必密集，只希望每一篇都来自一段真正发生过的学习或生活。</p>
</section>

<section class="timeline shell narrow">
  <% var lastYear = null; posts.forEach(function(post) { var y = date(post.date, 'YYYY'); %>
    <% if (y !== lastYear) { lastYear = y; %>
      <h2 class="timeline-year"><%= y %></h2>
    <% } %>
    <article class="timeline-item">
      <time><%= date(post.date, 'MM.DD') %></time>
      <div>
        <h3><a href="<%= url_for(post.path) %>"><%= post.title %></a></h3>
        <% if (post.categories && post.categories.length) { %>
          <div class="timeline-cat"><% post.categories.each(function(cat) { %><a href="<%= url_for(cat.path) %>"><%= cat.name %></a><% }) %></div>
        <% } %>
      </div>
    </article>
  <% }) %>
</section>
