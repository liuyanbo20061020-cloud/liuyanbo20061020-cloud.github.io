<%
  var metas = {
    '学习': { en: 'LEARNING', desc: '把复杂问题拆开，直到它真正变成自己的知识。' },
    '阅读': { en: 'READING', desc: '记录书页之外留下来的那一点回声。' },
    '电影': { en: 'MOVIES', desc: '不做标准影评，只记下银幕熄灭之后仍然留下的东西。' },
    '旅行': { en: 'TRAVEL', desc: '城市、车窗、街道和偶然遇见的人，组成另一种学习。' }
  };
  var meta = metas[page.category] || { en: 'CATEGORY', desc: '这一类文章的集合。' };
  var posts = page.posts && page.posts.toArray ? page.posts.toArray() : [];
  function plainText(html) { return String(html || '').replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim(); }
%>
<section class="listing-hero shell narrow">
  <div class="eyebrow"><%= meta.en %></div>
  <h1><%= page.category %></h1>
  <p><%= meta.desc %></p>
</section>

<section class="listing shell narrow">
  <% posts.forEach(function(post) { var text = plainText(post.excerpt || post.content); %>
    <article class="listing-item">
      <div class="listing-date"><%= date(post.date, 'YYYY.MM.DD') %></div>
      <h2><a href="<%= url_for(post.path) %>"><%= post.title %></a></h2>
      <p><%= text.length > 150 ? text.slice(0,150) + '…' : text %></p>
      <a class="text-link" href="<%= url_for(post.path) %>">继续阅读 →</a>
    </article>
  <% }) %>
</section>
